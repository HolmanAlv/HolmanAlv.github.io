---
layout: "../../layouts/Layout.astro"
title: "Chat at"
description: "A project about chat at"
import * as greatPost from "../../content/posts/chat_at.md";
const compiled = await greatPost.compiledContent();
const posts = Object.values(import.meta.glob("../../content/posts/*.md", { eager: true }));
---

<p>{greatPost.frontmatter.title}</p>
<p>Written by: {greatPost.frontmatter.author}</p>

<Fragment set:html={compiled} />

<p>Post Archive:</p>
<ul>
  {
    posts.map((post: any) => (
      <li>
        <a href={post.url}>{post.frontmatter.title}</a>
      </li>
    ))
  }
</ul>