---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import SkillGrid from '../components/SkillGrid.astro';
import ProjectRow from '../components/ProjectRow.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { profile } from '../data/profile';
import { stacks } from '../data/stacks';
import reelPoster from '../assets/images/art/reel-poster.png';

const projects = (await getCollection('projects', ({ data }) => data.discipline === 'art')).sort((a, b) => a.data.order - b.data.order);
// PLACEHOLDER: Blender's open movie "Agent 327" stands in for the showreel.
const reelId = 'mN0zPOpADL4';
const roles = ['Direction', 'Sound design', 'Foley', '3D and 2D animation'];
---

<Layout
    title="Artist · Holman Alvarado"
    description="Animation, sound design and filmmaking by Holman Alvarado: direction, foley, 3D and 2D animation for shorts, documentaries and promos."
    ogImage="/og/art.png"
>
    <section class="hero hero-split">
        <YouTubeFacade id={reelId} title="Showreel" poster={reelPoster} priority />
        <div class="hero-text">
            <div>
                <h1>Animator and sound designer</h1>
                <ul class="roles">
                    {roles.map((role) => <li>{role}</li>)}
                </ul>
                <div class="btn-row">
                    <a class="btn btn-primary" href={profile.cv.art}>Download CV</a>
                </div>
            </div>
        </div>
    </section>

    <Section title="Tools" id="tools">
        <SkillGrid groups={stacks.art} />
    </Section>

    <Section title="Selected works" id="works">
        {
            projects.map((entry) => (
                <ProjectRow entry={entry}>
                    {entry.data.youtubeId && <YouTubeFacade slot="media" id={entry.data.youtubeId} title={entry.data.title} poster={entry.data.cover} />}
                </ProjectRow>
            ))
        }
    </Section>

    <Section title="About" id="about">
        <p class="about">{profile.about.art}</p>
    </Section>
</Layout>

<style>
    .roles {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs) var(--space-md);
        margin-top: var(--space-md);
        padding: 0;
        list-style: none;
        font-size: var(--text-lg);
        color: var(--color-muted);
    }

    .about {
        max-width: var(--measure);
        font-size: var(--text-lg);
        line-height: 1.7;
    }
</style>
