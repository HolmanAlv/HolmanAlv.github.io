---
import { disciplines } from '../data/disciplines';

// Build paths end with a slash (/dev/), so the hrefs do too.
const currentPath = Astro.url.pathname;
const links = Object.entries(disciplines).map(([key, { label }]) => ({ label, href: `/${key}/` }));
---

<header class="site-header wrap">
    <a href="/" class="brand">
        <span class="mark" aria-hidden="true">H</span>
        Holman Alvarado
    </a>
    <nav aria-label="Main">
        <ul>
            {
                links.map((link) => (
                    <li>
                        <a href={link.href} aria-current={link.href === currentPath ? 'page' : undefined}>
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
    <a href="#contact" class="btn btn-outline contact">Contact</a>
</header>

<style>
    .site-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-xs) var(--space-lg);
        padding-block: var(--space-md);
    }

    a {
        text-decoration: none;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: var(--space-xs);
        margin-right: auto;
        font-weight: 500;
        letter-spacing: 0.04em;
    }

    /* The monogram, the same square as the favicon. */
    .mark {
        display: grid;
        place-items: center;
        width: 1.75rem;
        aspect-ratio: 1;
        background: var(--color-fg);
        color: var(--color-bg);
        font-size: var(--text-sm);
        font-weight: 700;
        line-height: 1;
    }

    ul {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-lg);
        padding: 0;
        list-style: none;
    }

    nav a {
        display: inline-block;
        padding-block: var(--space-3xs);
        font-size: var(--text-sm);
        letter-spacing: 0.04em;
        border-bottom: 1px solid transparent;
    }

    nav a[aria-current='page'] {
        border-bottom-color: currentColor;
    }

    .contact {
        padding: var(--space-2xs) var(--space-sm);
    }

    @media (max-width: 40rem) {
        nav {
            order: 3;
            width: 100%;
        }
    }
</style>
