---
import Section from './Section.astro';
import { profile } from '../data/profile';

const currentYear = new Date().getFullYear();
---

<footer id="contact" class="wrap">
    <Section title="Work with me">
        <p class="location">{profile.location}</p>
        <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <ul class="socials">
            {
                Object.values(profile.socials).map((social) => (
                    <li>
                        <a href={social.url}>{social.label}</a>
                    </li>
                ))
            }
        </ul>
    </Section>
    <p class="legal">
        © {currentYear} {profile.name} · <a href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a>
    </p>
</footer>

<style>
    .location {
        color: var(--color-muted);
    }

    .email {
        display: inline-block;
        margin-top: var(--space-sm);
        font-size: clamp(var(--text-xl), 3vw + 0.5rem, var(--text-2xl));
        font-weight: 300;
        overflow-wrap: anywhere;
    }

    .socials {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs) var(--space-lg);
        margin-top: var(--space-xl);
        padding: 0;
        list-style: none;
        font-size: var(--text-sm);
    }

    .legal {
        padding-block: var(--space-lg);
        font-size: var(--text-xs);
        color: var(--color-muted);
    }
</style>
