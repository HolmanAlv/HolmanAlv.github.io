---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import TagList from './TagList.astro';

interface Props {
    entry: CollectionEntry<'projects'>;
    /** A wider media column (GameDev). */
    wide?: boolean;
}

const { entry, wide = false } = Astro.props;
const { title, subtitle, summary, tags, role, result, links, cover, coverAlt, meta } = entry.data;
// Same check as the filter in pages/projects/[id].astro: a body means a case study page.
const hasCaseStudy = Boolean(entry.body?.trim());
---

<article id={entry.id} class:list={['row', { wide }]}>
    <div class="media">
        <slot name="media">
            <Image src={cover} alt={coverAlt} widths={[480, 720, 960, 1440]} sizes="(min-width: 75rem) 480px, (min-width: 60rem) 40vw, 100vw" />
        </slot>
    </div>

    <div class="info">
        <h3>{title}</h3>
        {subtitle && <p class="subtitle">{subtitle}</p>}
        <p>{summary}</p>
        {
            meta && (
                <dl class="meta">
                    {Object.entries(meta).map(([key, value]) => (
                        <div>
                            <dt>{key}</dt>
                            <dd>{value}</dd>
                        </div>
                    ))}
                </dl>
            )
        }
        <TagList tags={tags} />
        <p class="fact"><span>Role</span>{role}</p>
        {result && <p class="fact result"><span>Result</span>{result}</p>}
        {
            (links.length > 0 || hasCaseStudy) && (
                <ul class="links">
                    {hasCaseStudy && (
                        <li>
                            <a href={`/projects/${entry.id}/`}>Read the case study</a>
                        </li>
                    )}
                    {links.map((link) => (
                        <li>
                            <a href={link.url}>
                                {link.label} <span aria-hidden="true">↗</span>
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
</article>

<style>
    .row {
        display: grid;
        gap: var(--space-md) var(--space-xl);
        scroll-margin-top: var(--space-lg);
    }

    .row + .row {
        margin-top: var(--space-3xl);
    }

    @media (min-width: 60rem) {
        .row {
            grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
            align-items: start;
        }

        .wide {
            grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
        }
    }

    .media :global(img) {
        width: 100%;
        height: auto;
    }

    .info {
        display: grid;
        gap: var(--space-sm);
        justify-items: start;
        max-width: var(--measure);
    }

    h3 {
        font-size: var(--text-xl);
    }

    .subtitle {
        margin-top: calc(-1 * var(--space-xs));
        color: var(--color-muted);
    }

    .fact {
        font-size: var(--text-sm);
    }

    .fact span {
        display: inline-block;
        min-width: 4.5rem;
        color: var(--color-muted);
    }

    .result {
        padding-left: var(--space-sm);
        border-left: 2px solid var(--color-fg);
    }

    .result span {
        min-width: calc(4.5rem - var(--space-sm) - 2px);
    }

    .meta {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
        gap: var(--space-xs) var(--space-sm);
        width: 100%;
        font-size: var(--text-sm);
    }

    dt {
        font-size: var(--text-xs);
        letter-spacing: 0.04em;
        color: var(--color-muted);
    }

    dd {
        margin: 0;
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs) var(--space-md);
        padding: 0;
        list-style: none;
        font-size: var(--text-sm);
        font-weight: 500;
    }
</style>
