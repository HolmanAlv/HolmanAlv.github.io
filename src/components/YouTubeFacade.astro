---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
    id: string;
    title: string;
    poster: ImageMetadata;
    /** Only for the video at the top of the page: loads its poster first. */
    priority?: boolean;
}

const { id, title, poster, priority = false } = Astro.props;
---

<div class="facade">
    <a href={`https://www.youtube.com/watch?v=${id}`} data-youtube-id={id} data-title={title} aria-label={`Play video: ${title}`}>
        <Image src={poster} alt="" widths={[640, 960, 1280, 1920]} sizes="(min-width: 75rem) 640px, (min-width: 60rem) 50vw, 100vw" priority={priority} />
        <svg class="play" viewBox="0 0 64 64" aria-hidden="true">
            <circle cx="32" cy="32" r="31" />
            <path d="M26 21 L45 32 L26 43 Z" />
        </svg>
    </a>
</div>

<script>
    // Swap each poster link for the real player, only when someone asks for it.
    // Without JS the link still opens the video on YouTube.
    for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-youtube-id]')) {
        link.addEventListener('click', (event) => {
            event.preventDefault();
            const iframe = document.createElement('iframe');
            iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtubeId}?autoplay=1`;
            iframe.title = link.dataset.title ?? 'YouTube video';
            iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
            iframe.allowFullscreen = true;
            link.replaceWith(iframe);
            iframe.focus();
        });
    }
</script>

<style>
    .facade {
        position: relative;
        aspect-ratio: 16 / 9;
        background: var(--color-night);
    }

    a,
    img,
    .facade :global(iframe) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    img {
        object-fit: cover;
    }

    .facade :global(iframe) {
        border: 0;
    }

    .play {
        position: absolute;
        inset: 50% auto auto 50%;
        width: clamp(3rem, 8vw, 4.5rem);
        translate: -50% -50%;
        transition: scale 0.2s;
    }

    .play circle {
        fill: var(--white);
        opacity: 0.92;
    }

    .play path {
        fill: var(--gray-900);
    }

    a:hover .play {
        scale: 1.08;
    }

    a:focus-visible {
        outline-offset: -4px;
    }
</style>
