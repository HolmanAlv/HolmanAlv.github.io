---
interface Props {
    tags?: string[];
}

const { tags = [] } = Astro.props;
---

{
    tags.length > 0 && (
        <ul class="tags">
            {tags.map((tag) => (
                <li>{tag}</li>
            ))}
        </ul>
    )
}

<style>
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs);
        padding: 0;
        list-style: none;
    }

    li {
        padding: var(--space-3xs) var(--space-2xs);
        border: 1px solid var(--color-line);
        font-size: var(--text-xs);
        letter-spacing: 0.04em;
        line-height: 1.5;
        color: var(--color-muted);
    }
</style>
